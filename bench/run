#!/usr/bin/env bash

set -Eeuo pipefail

shopt -s nullglob

pushd "$(dirname "$0")" >/dev/null

results_dir="$PWD/results"
input_dir="$PWD/inputs"
iterations=${MHB_ITERATIONS:-5}

# When running without cached sudo credentials (e.g. in CI or background tasks),
# fall back to a non-root run instead of blocking on an interactive PAM prompt.
if sudo -n true >/dev/null 2>&1; then
  have_sudo=1
else
  have_sudo=0
  echo "No cached sudo credentials; running without CPU governor / taskset / nice." >&2
fi

if [[ "$have_sudo" -eq 1 ]]; then
  for i in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo performance | sudo dd status=none of="$i"
  done
fi

mkdir -p "$results_dir"

pushd runners >/dev/null
for r in *; do
  if [[ ! -d "$r" ]] || [[ "$r" == "node_modules" ]]; then
    continue
  fi
  echo "Running $r..."
  pushd "$r" >/dev/null
  out="$results_dir/$r.json"
  if [[ "$(uname -s)" = "Darwin" ]]; then
    MHB_ITERATIONS="$iterations" MHB_INPUT_DIR="$input_dir" RUST_BACKTRACE=1 ./run >"$out"
  elif [[ "$have_sudo" -eq 1 ]]; then
    sudo --preserve-env=MHB_HTML_ONLY,PATH MHB_ITERATIONS="$iterations" MHB_INPUT_DIR="$input_dir" RUST_BACKTRACE=1 nice -n -20 taskset -c 1 ./run >"$out"
  else
    MHB_ITERATIONS="$iterations" MHB_INPUT_DIR="$input_dir" RUST_BACKTRACE=1 ./run >"$out"
  fi
  popd >/dev/null
done
popd >/dev/null

echo "All done!"

popd >/dev/null
